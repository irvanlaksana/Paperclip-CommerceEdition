# ============================================================================
#  PAPERCLIP COMMERCE EDITION - ENVIRONMENT TEMPLATE
#  Copy to `.env` then fill in what you need:  cp .env.example .env
#
#  >>> SWAPPING THE AI PROVIDER IS A CONFIG-ONLY OPERATION <<<
#  You never have to touch application code. Two steps:
#    1. Put your API key in the matching <TYPE>_API_KEY variable below.
#    2. Point AI_DEFAULT_PROVIDER at that type.
#  Anything saved through the Settings UI (database/store) overrides these
#  values, so env acts as the seed and the DB acts as the runtime override.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. AI PROVIDER SELECTION
# ---------------------------------------------------------------------------
# Which provider answers by default.
# Valid values: GEMINI | OPENAI | CLAUDE | DEEPSEEK | GROK | OPENROUTER
#               OLLAMA | LM_STUDIO | OPENCLAW | CUSTOM | MOCK
AI_DEFAULT_PROVIDER=MOCK

# Comma separated fail-over chain, tried in order when the default provider
# errors out or is rate limited. Leave empty to disable fail-over.
AI_FALLBACK_PROVIDERS=

# When no usable API key is found, degrade to the offline MOCK driver instead
# of throwing. Handy for demos/CI. Set to false in production.
AI_ALLOW_MOCK_FALLBACK=true

# Global generation defaults (per-provider <TYPE>_* values win over these).
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# 2. PER-PROVIDER CREDENTIALS
#    Uniform pattern for EVERY provider type:
#      <TYPE>_API_KEY | <TYPE>_MODEL | <TYPE>_ENDPOINT
#      <TYPE>_TEMPERATURE | <TYPE>_MAX_TOKENS | <TYPE>_ENABLED
#    Only the API key is required; the rest fall back to catalog defaults.
# ---------------------------------------------------------------------------

# --- Google Gemini (native REST driver) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# --- OpenAI (OpenAI-compatible driver) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1

# --- Anthropic Claude (native Messages driver) ---
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
# CLAUDE_ENDPOINT=https://api.anthropic.com/v1
# CLAUDE_API_VERSION=2023-06-01

# --- DeepSeek (OpenAI-compatible driver) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1

# --- xAI Grok (OpenAI-compatible driver) ---
XAI_API_KEY=
GROK_API_KEY=
GROK_MODEL=grok-4-fast
# GROK_ENDPOINT=https://api.x.ai/v1

# --- OpenRouter (OpenAI-compatible driver, 300+ models behind one key) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1

# --- Ollama (local, OpenAI-compatible driver, no key needed) ---
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2
# OLLAMA_ENDPOINT=http://localhost:11434/v1

# --- LM Studio (local, OpenAI-compatible driver, no key needed) ---
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=local-model
# LM_STUDIO_ENDPOINT=http://localhost:1234/v1

# --- OpenClaw (OpenAI-compatible driver) ---
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw-1
# OPENCLAW_ENDPOINT=https://api.openclaw.ai/v1

# --- Any other OpenAI-compatible endpoint (vLLM, Together, Groq, Azure-ish) ---
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_ENDPOINT=http://localhost:8080/v1

# ---------------------------------------------------------------------------
# 3. APPLICATION
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_HOST=0.0.0.0
# Comma separated list of browser origins allowed to call the API directly.
# The web app proxies through Next.js rewrites, so this is only needed when
# the browser talks to the API without the proxy.
CORS_ORIGINS=

WEB_PORT=3000
# Base URL the API uses to reach itself / the web app (used in preview setups).
NEXT_PUBLIC_API_BASE=/api

# Server-side API origin used by Next.js rewrites. Keep this as the public URL
# of the deployed NestJS API in Vercel (without a trailing slash).
# API_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------------
# 4. PERSISTENCE
# ---------------------------------------------------------------------------
# memory -> nothing persisted (fastest, data lost on restart)
# file   -> JSON files under .data/ (DEFAULT: zero setup, survives restarts)
# prisma -> PostgreSQL through Prisma (production)
DATA_DRIVER=file
DATA_DIR=.data

# Only used when DATA_DRIVER=prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paperclip?schema=public

# ---------------------------------------------------------------------------
# 5. OPTIONAL INTEGRATIONS
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
REDIS_URL=redis://localhost:6379
