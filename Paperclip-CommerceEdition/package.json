{
  "name": "paperclip-commerce-edition",
  "version": "1.1.0",
  "private": true,
  "description": "Paperclip AI - Commerce Edition. Agentic workflow platform for e-commerce operations with a swappable AI provider layer and an AI content production pipeline.",
  "license": "ISC",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "packages:build": "pnpm --filter @paperclip/shared build && pnpm --filter @paperclip/database build",
    "dev": "pnpm packages:build && pnpm --parallel --filter @paperclip/api --filter @paperclip/web dev",
    "dev:api": "pnpm packages:build && pnpm --filter @paperclip/api dev",
    "dev:web": "pnpm packages:build && pnpm --filter @paperclip/web dev",
    "dev:shared": "pnpm --filter @paperclip/shared dev",
    "build": "pnpm packages:build && pnpm --filter @paperclip/api build && pnpm --filter @paperclip/web build",
    "start": "pnpm --parallel --filter @paperclip/api --filter @paperclip/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @paperclip/database generate",
    "db:migrate": "pnpm --filter @paperclip/database migrate",
    "db:push": "pnpm --filter @paperclip/database push",
    "db:seed": "pnpm --filter @paperclip/database seed"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
