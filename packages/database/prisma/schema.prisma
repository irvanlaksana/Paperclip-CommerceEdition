// Prisma schema - Paperclip Commerce Edition
//
// NOTE (Prisma 7): connection URLs no longer live in this file. The datasource
// URL is declared in ../prisma.config.ts and, at runtime, passed to
// PrismaClient through a driver adapter (see ../src/client.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CEO
  COO
  CTO
  CMO
  MARKETPLACE_MANAGER
  PRODUCT_RESEARCH_MANAGER
  CONTENT_MANAGER
  SEO_MANAGER
  ADS_MANAGER
  REPORTING_MANAGER
  USER
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum AIProviderType {
  GEMINI
  OPENAI
  CLAUDE
  DEEPSEEK
  GROK
  OPENROUTER
  OLLAMA
  LM_STUDIO
  OPENCLAW
  CUSTOM
  MOCK
}

enum WorkProductStatus {
  DRAFT
  APPROVED
  REJECTED
}

model Company {
  id          String       @id @default(cuid())
  name        String
  industry    String?
  goals       Goal[]
  users       User[]
  products    Product[]
  contentRuns ContentRun[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      Role     @default(USER)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("ACTIVE")
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("PLANNING")
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id])
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Issue {
  id           String        @id @default(cuid())
  title        String
  description  String?
  status       IssueStatus   @default(TODO)
  priority     String        @default("MEDIUM")
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  agentId      String?
  agent        Agent?        @relation(fields: [agentId], references: [id])
  workProducts WorkProduct[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Agent {
  id           String     @id @default(cuid())
  name         String
  role         Role
  systemPrompt String     @db.Text
  providerId   String?
  provider     AIProvider? @relation(fields: [providerId], references: [id])
  issues       Issue[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Runtime AI provider records. These OVERRIDE the values seeded from .env,
/// which is what makes swapping the AI vendor a Settings-UI operation.
model AIProvider {
  id                String         @id @default(cuid())
  name              String
  type              AIProviderType
  model             String
  endpoint          String?
  /// Stored encrypted at rest in production; never returned to the browser.
  apiKey            String?        @db.Text
  enabled           Boolean        @default(true)
  /// Lower value = tried first when the fail-over chain is built.
  priority          Int            @default(100)
  isDefault         Boolean        @default(false)
  temperature       Float?
  maxTokens         Int?
  headers           Json?
  /// STORE | ENV | CATALOG
  source            String         @default("STORE")
  lastTestAt        DateTime?
  lastTestStatus    String?
  lastTestMessage   String?        @db.Text
  lastTestLatencyMs Int?
  agents            Agent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([type])
}

/// One execution of the content production pipeline.
model ContentRun {
  id           String        @id @default(cuid())
  productName  String
  /// QUEUED | RUNNING | COMPLETED | PARTIAL | FAILED
  status       String        @default("QUEUED")
  platforms    String[]
  locale       String        @default("id-ID")
  tone         String        @default("casual")
  providerType String?
  input        Json
  stages       Json
  error        String?       @db.Text
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
  workProducts WorkProduct[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model WorkProduct {
  id           String            @id @default(cuid())
  title        String
  content      String            @db.Text
  /// RESEARCH | CAPTION | SEO | IMAGE_PROMPT | SCHEDULE | DESCRIPTION | SHEET_DATA
  type         String
  stage        String?
  platform     String?
  payload      Json?
  status       WorkProductStatus @default(DRAFT)
  providerType String?
  model        String?
  issueId      String?
  issue        Issue?            @relation(fields: [issueId], references: [id])
  runId        String?
  run          ContentRun?       @relation(fields: [runId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([runId])
  @@index([status])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Float
  currency    String   @default("IDR")
  sku         String?  @unique
  imageUrl    String?
  sourceUrl   String?
  category    String?
  tags        String[]
  attributes  Json?
  /// Optional so products can be created before a company record exists.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketplaceChannel {
  id        String   @id @default(cuid())
  name      String
  apiKey    String?
  shopId    String?
  status    String   @default("DISCONNECTED")
  companyId String
  createdAt DateTime @default(now())
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String
  updatedAt DateTime @updatedAt
}
